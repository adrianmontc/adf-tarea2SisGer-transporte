{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 filter(!isNull(ViajeId) && trim(ViajeId) != '' && !isNull(RutaHistoricaId) && trim(RutaHistoricaId) != '') ~> filter1",
				"filter1 derive(ViajeId = upper(trim(ViajeId)),",
				"          RutaHistoricaId = upper(trim(iif(isNull(RutaHistoricaId) || trim(RutaHistoricaId) == '' || trim(RutaHistoricaId) == 'NULL', 'RH-01', iif(instr(RutaHistoricaId, 'RH-') > 0, RutaHistoricaId, concat('RH-', lpad(regexExtract(RutaHistoricaId, '([0-9]+)', 1), 2, '0')))))),",
				"          VehiculoId = upper(trim(iif(isNull(VehiculoId) || trim(VehiculoId) == '' || trim(VehiculoId) == 'NULL', 'V-001', iif(instr(VehiculoId, 'V-') > 0, VehiculoId, concat('V-', lpad(regexExtract(VehiculoId, '([0-9]+)', 1), 3, '0')))))),",
				"          ValidacionesTarjeta = toInteger(iif(isNull(ValidacionesTarjeta) || trim(toString(ValidacionesTarjeta)) == '', 0, toInteger(trim(toString(ValidacionesTarjeta))))),",
				"          KmRecorridos = toDecimal(iif(isNull(KmRecorridos) || trim(toString(KmRecorridos)) == '', toDecimal(0.0, 8, 1), toDecimal(replace(trim(toString(KmRecorridos)), ',', '.'), 8, 1)), 8, 1),",
				"          EstadoViaje = upper(trim(coalesce(EstadoViaje, 'COMPLETADO')))) ~> derivedColumn1",
				"derivedColumn1 derive(FechaServicio = coalesce(toDate(trim(toString(FechaServicio)), 'yyyy-MM-dd'), toDate('2024-07-13', 'yyyy-MM-dd')),",
				"          HoraProgramada = iif(     isNull(HoraProgramada),     '00:00:00',     iif(         isNull(toString(HoraProgramada, 'HH:mm:ss')),         '00:00:00',         toString(HoraProgramada, 'HH:mm:ss')     ) ),",
				"          HoraSalida = iif(     \r",
				"    isNull(HoraSalida),'00:00:00',     \r",
				"    iif(         \r",
				"        isNull(toString(HoraSalida, 'HH:mm:ss')),        \r",
				"         '00:00:00',toString(HoraSalida, 'HH:mm:ss'))\r",
				" ),",
				"          HoraLlegada = iif(\r",
				"    isNull(HoraLlegada),\r",
				"    '00:00:00',\r",
				"    iif(\r",
				"        isNull(toString(HoraLlegada, 'HH:mm:ss')),\r",
				"        '00:00:00',\r",
				"        toString(HoraLlegada, 'HH:mm:ss')\r",
				"    )\r",
				")) ~> derivedColumn2",
				"derivedColumn2 aggregate(groupBy(ViajeId),",
				"     RutaHistoricaId = first(RutaHistoricaId),",
				"          VehiculoId = first(VehiculoId),",
				"          FechaServicio = first(FechaServicio),",
				"          HoraProgramada = first(HoraProgramada),",
				"          HoraSalida = first(HoraSalida),",
				"          HoraLlegada = first(HoraLlegada),",
				"          ValidacionesTarjeta = first(ValidacionesTarjeta),",
				"          KmRecorridos = first(KmRecorridos),",
				"          EstadoViaje = first(EstadoViaje)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'allErrors',",
				"     transactionCommit: 'single',",
				"     reportSuccessOnError: false) ~> sink1"
			]
		}
	}
}