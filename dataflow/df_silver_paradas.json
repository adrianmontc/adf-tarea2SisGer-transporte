{
	"name": "df_silver_paradas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as string,",
				"          Longitud as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 filter(!isNull(ParadaHistoricaId) && trim(ParadaHistoricaId) != '') ~> filter1",
				"filter1 derive(ParadaHistoricaId = upper(trim(ParadaHistoricaId)),",
				"          CodigoPublicado = upper(trim(coalesce(CodigoPublicado, ParadaHistoricaId))),",
				"          NombreParada = trim(NombreParada),",
				"          Zona = trim(Zona),",
				"          Latitud = toDecimal(iif(isNull(Latitud) || trim(Latitud) == '', '0', trim(Latitud)), 9, 6),",
				"          Longitud = toDecimal(iif(isNull(Longitud) || trim(Longitud) == '', '0', trim(Longitud)), 9, 6),",
				"          Estado = upper(trim(Estado))) ~> derivedColumn1",
				"derivedColumn1 derive(VigenciaDesde = coalesce(iif(regexMatch(trim(toString(VigenciaDesde)), '^[0-9]{5}$'), addDays(toDate('1899-12-30', 'yyyy-MM-dd'), toInteger(trim(toString(VigenciaDesde)))), coalesce(toDate(trim(toString(VigenciaDesde)), 'yyyy-MM-dd'), toDate(trim(toString(VigenciaDesde)), 'dd/MM/yyyy'))), toDate('2020-01-01', 'yyyy-MM-dd')),",
				"          VigenciaHasta = coalesce(iif(regexMatch(trim(toString(VigenciaHasta)), '^[0-9]{5}$'), addDays(toDate('1899-12-30', 'yyyy-MM-dd'), toInteger(trim(toString(VigenciaHasta)))), coalesce(toDate(trim(toString(VigenciaHasta)), 'yyyy-MM-dd'), toDate(trim(toString(VigenciaHasta)), 'dd/MM/yyyy'))), toDate('2025-12-31', 'yyyy-MM-dd'))) ~> derivedColumn2",
				"derivedColumn2 aggregate(groupBy(ParadaHistoricaId),",
				"     CodigoPublicado = first(CodigoPublicado),",
				"          NombreParada = first(NombreParada),",
				"          Zona = first(Zona),",
				"          Latitud = max(Latitud),",
				"          Longitud = max(Longitud),",
				"          VigenciaDesde = min(VigenciaDesde),",
				"          VigenciaHasta = max(VigenciaHasta),",
				"          Estado = first(Estado)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ParadaHistoricaId as string,",
				"          CodigoPublicado as string,",
				"          NombreParada as string,",
				"          Zona as string,",
				"          Latitud as decimal(9,6),",
				"          Longitud as decimal(9,6),",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ParadaHistoricaId,",
				"          CodigoPublicado,",
				"          NombreParada,",
				"          Zona,",
				"          Latitud,",
				"          Longitud,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}